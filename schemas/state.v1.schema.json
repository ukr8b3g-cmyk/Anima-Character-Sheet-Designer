{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anima-character-sheet:state:1",
  "title": "Proposed Anima Character Sheet Designer state v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "anima_character_sheet"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "face_front",
          "face_left",
          "face_right",
          "face_3q_left",
          "face_3q_right",
          "face_back",
          "body_front",
          "body_left",
          "body_back",
          "clothing_front",
          "clothing_back",
          "hands",
          "feet"
        ]
      }
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "unspecified",
        "woman",
        "man",
        "person",
        "nonhuman"
      ]
    },
    "part_prompts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_hair": {
          "type": "string",
          "maxLength": 1000
        },
        "face": {
          "type": "string",
          "maxLength": 1000
        },
        "upper_clothing": {
          "type": "string",
          "maxLength": 1000
        },
        "back_clothing": {
          "type": "string",
          "maxLength": 1000
        },
        "lower_body": {
          "type": "string",
          "maxLength": 1000
        },
        "hands": {
          "type": "string",
          "maxLength": 1000
        },
        "footwear": {
          "type": "string",
          "maxLength": 1000
        },
        "other": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": []
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hand_state": {
          "type": "string",
          "enum": [
            "auto",
            "bare",
            "gloved"
          ]
        },
        "clothing_type": {
          "type": "string",
          "enum": [
            "auto",
            "pants",
            "skirt_robe"
          ]
        },
        "footwear_state": {
          "type": "string",
          "enum": [
            "auto",
            "shod",
            "unshod"
          ]
        }
      },
      "required": [
        "hand_state",
        "clothing_type",
        "footwear_state"
      ]
