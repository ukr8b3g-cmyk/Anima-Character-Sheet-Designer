        },
        "body_left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "body_back": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "clothing_front": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "clothing_back": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
