        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "body_height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16384,
          "multipleOf": 16
        },
        "pixel_budget": {
          "type": "integer",
          "enum": [
            1000000,
            1500000,
            2000000,
            4000000
          ]
        },
        "manual_width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16384,
          "multipleOf": 16
