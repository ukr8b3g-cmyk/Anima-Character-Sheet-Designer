        },
        "body_front": {
          "type": "string",
          "maxLength": 2000
        },
        "body_left": {
          "type": "string",
          "maxLength": 2000
        },
        "body_back": {
          "type": "string",
          "maxLength": 2000
        },
        "clothing_front": {
          "type": "string",
          "maxLength": 2000
        },
        "clothing_back": {
          "type": "string",
          "maxLength": 2000
        },
        "hands": {
          "type": "string",
          "maxLength": 2000
        },
        "feet": {
          "type": "string",
          "maxLength": 2000
        }
