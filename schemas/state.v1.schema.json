    "style": {
      "type": "string",
      "enum": [
        "none",
        "anime",
        "photo",
        "realistic_painting",
        "semi_realistic_anime",
        "oil_painting",
        "watercolor",
        "gouache",
        "colored_pencil",
        "3d"
      ]
    },
    "background": {
      "type": "string",
      "enum": [
        "white",
        "light_gray"
      ]
    },
    "render_profile": {
      "type": "string",
      "enum": [
        "standard",
        "low_memory"
      ]
    },
    "view_seed_offsets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "face_front": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "face_left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "face_right": {
          "type": "integer",
