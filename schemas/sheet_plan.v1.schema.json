{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anima-character-sheet:plan:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "compiler_revision",
    "canvas",
    "background",
    "reference_hash",
    "views",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "anima_character_sheet_plan"
    },
    "compiler_revision": {
      "const": "anima-sheet-1.0.0"
    },
    "canvas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 256,
        "maximum": 16384,
        "multipleOf": 16
      }
    },
    "background": {
      "enum": [
        "white",
        "light_gray"
      ]
    },
    "reference_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view_id",
          "bounds"
        ],
        "properties": {
          "view_id": {
            "enum": [
              "face_front",
              "face_left",
              "face_right",
              "face_3q_left",
              "face_3q_right",
              "face_back",
              "body_front",
              "body_left",
              "body_back",
              "clothing_front",
              "clothing_back",
              "hands",
              "feet"
            ]
          },
          "bounds": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384
            }
          }
        }
      }
    }
  },
  "$comment": "Runtime must additionally verify hash, canonical view order, unique IDs, nonoverlap, positive area, canvas containment, <=16777216 pixels, and the runtime MAX_RESOLUTION."
}
