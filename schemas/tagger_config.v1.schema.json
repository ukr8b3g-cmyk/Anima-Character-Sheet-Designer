{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anima Tagger Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "thresholds",
    "include_character",
    "include_copyright",
    "exclude_tags",
    "scope_additions",
    "multi_subject_policy",
    "max_tags",
    "device_id",
    "refresh_nonce"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "anima_tagger_config"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general",
        "character",
        "style",
        "copyright",
        "meta",
        "rating"
      ],
      "properties": {
        "general": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "character": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "style": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "copyright": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "meta": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "include_character": {
      "type": "boolean"
    },
    "include_copyright": {
      "type": "boolean"
    },
    "exclude_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 512
    },
    "scope_additions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "hair": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "face": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "upper_outfit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "lower_outfit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "hands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "feet": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "head_accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "body_accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 128,
          "uniqueItems": true
        }
      }
    },
    "multi_subject_policy": {
      "enum": [
        "block",
        "allow_with_warning"
      ]
    },
    "max_tags": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "device_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "refresh_nonce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
