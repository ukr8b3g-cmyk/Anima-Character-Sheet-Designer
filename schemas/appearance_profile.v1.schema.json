{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anima appearance profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_mode",
    "image_hash",
    "model_id",
    "model_sha256",
    "preprocess_revision",
    "filter_revision",
    "prompt_sha256",
    "groups",
    "identity_labels",
    "user_additions",
    "review_count",
    "profile_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "anima_appearance_profile"
    },
    "source_mode": {
      "const": "image_tags"
    },
    "image_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_id": {
      "enum": [
        "pixai_v1_fp16",
        "wd_eva02_large_v3"
      ]
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preprocess_revision": {
      "type": "string",
      "minLength": 1
    },
    "filter_revision": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "hair",
        "face",
        "body",
        "upper_outfit",
        "lower_outfit",
        "hands",
        "feet",
        "head_accessories",
        "body_accessories"
      ],
      "properties": {
        "subject": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "hair": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "face": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "upper_outfit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "lower_outfit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "hands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "feet": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "head_accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "body_accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      }
    },
    "identity_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "copyright"
      ],
      "properties": {
        "character": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "copyright": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 8
        }
      }
    },
    "user_additions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "hair": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "face": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "upper_outfit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "lower_outfit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "hands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "feet": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "head_accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "body_accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      }
    },
    "review_count": {
      "type": "integer",
      "minimum": 0
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
