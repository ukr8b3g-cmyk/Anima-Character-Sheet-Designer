{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anima View Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_id",
    "sheet_plan_hash",
    "width",
    "height",
    "seed",
    "positive",
    "record_kind"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "view_id": {
      "enum": [
        "face_front",
        "face_left",
        "face_right",
        "face_3q_left",
        "face_3q_right",
        "face_back",
        "body_front",
        "body_left",
        "body_back",
        "clothing_front",
        "clothing_back",
        "hands",
        "feet"
      ]
    },
    "sheet_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "width": {
      "type": "integer",
      "minimum": 16,
      "maximum": 16384,
      "multipleOf": 16
    },
    "height": {
      "type": "integer",
      "minimum": 16,
      "maximum": 16384,
      "multipleOf": 16
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "string",
      "minLength": 1
    },
    "record_kind": {
      "const": "declared_generation_plan"
    }
  },
  "$comment": "No negative field: the existing external negative encoder remains authoritative. Verify all selected records before assembly."
}
